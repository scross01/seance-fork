#!/usr/bin/env bash
# seance Freebuff wrapper — intercepts `freebuff` invocations inside seance
# terminals and tracks the process lifecycle so seance can detect agent exit.
set -euo pipefail

# ── Find the real freebuff binary, skipping our own directory ────────────

WRAPPER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REAL_FREEBUFF=""
IFS=: read -ra PATH_DIRS <<< "$PATH"
for dir in "${PATH_DIRS[@]}"; do
    [[ -z "$dir" ]] && continue
    resolved="$(cd "$dir" 2>/dev/null && pwd)" || continue
    [[ "$resolved" == "$WRAPPER_DIR" ]] && continue
    if [[ -x "$dir/freebuff" ]]; then
        REAL_FREEBUFF="$dir/freebuff"
        break
    fi
done

if [[ -z "$REAL_FREEBUFF" ]]; then
    echo "freebuff: command not found" >&2
    exit 127
fi

# Resolve seance to an absolute path
REAL_SEANCE="$(PATH="$PATH" type -P seance 2>/dev/null || true)"
if [[ -z "$REAL_SEANCE" ]]; then
    echo "freebuff: seance not found — falling back to pass-through" >&2
    exec "$REAL_FREEBUFF" "$@"
fi

# ── Pass-through conditions ──────────────────────────────────────────────

# Not inside seance
if [[ -z "${SEANCE_SURFACE_ID:-}" ]]; then
    exec "$REAL_FREEBUFF" "$@"
fi

# Hooks explicitly disabled
if [[ "${SEANCE_FREEBUFF_HOOKS_DISABLED:-}" == "1" ]]; then
    exec "$REAL_FREEBUFF" "$@"
fi

# Socket health check (0.75s timeout)
if ! timeout 0.75 "$REAL_SEANCE" ctl --socket "${SEANCE_SOCKET_PATH:-}" ping >/dev/null 2>&1; then
    exec "$REAL_FREEBUFF" "$@"
fi

# ── Export PID ─────────────────────────────────────────────────────────────

export SEANCE_FREEBUFF_PID=$$

# ── Session-end cleanup trap ───────────────────────────────────────────────

_STATUS_MONITOR_PID=""
_cleanup() {
    kill $_STATUS_MONITOR_PID 2>/dev/null || true
    timeout 0.5 "$REAL_SEANCE" ctl freebuff-hook session-end <<'EOF' >/dev/null 2>&1 &
{}
EOF
}
trap _cleanup EXIT

# ── Set initial "Running" status ───────────────────────────────────────────

"$REAL_SEANCE" ctl freebuff-hook prompt-submit <<'EOF' >/dev/null 2>&1 || true
{}
EOF

# ── Start background status monitor ────────────────────────────────────────
# Discovers this session's own log.jsonl (Freebuff 0.2.x writes a fresh
# chats/<timestamp>/log.jsonl per launch), then watches that single file.
# Requires inotify-tools.
MANICODE_DIR="${HOME}/.config/manicode"

_fire_status() {   # $1 = Running|Idle
    timeout 0.5 "$REAL_SEANCE" ctl freebuff-hook prompt-submit <<EOF >/dev/null 2>&1 || true
{"status":"$1"}
EOF
}

_start_status_monitor() {
    (
        local idle_timeout=5 state_file watch_pid=""
        state_file=$(mktemp /tmp/freebuff-status-XXXXXX)
        echo "Idle" > "$state_file"
        # The wrapper's EXIT trap kills this subshell; reap our watch child
        # and state file so nothing outlives the session. HUP covers pane
        # teardown (tmux/session death) where the EXIT trap never runs.
        trap '[[ -n "$watch_pid" ]] && kill "$watch_pid" 2>/dev/null; rm -f "$state_file"; exit 0' TERM INT HUP

        _log_candidates() {   # recent log.jsonl candidates, newest first
            local proj="$MANICODE_DIR/projects/$(basename "$PWD")/chats"
            {
                find "$proj" -name log.jsonl -newermt '-5 seconds' \
                    -printf '%T@ %p\n' 2>/dev/null || true
                find "$MANICODE_DIR/projects" -name log.jsonl \
                    -newermt '-5 seconds' -printf '%T@ %p\n' 2>/dev/null || true
            } | sort -rn | head -25
        }

        _cli_pids() {   # wrapper's descendant PIDs (npm launcher spawns
            # the real CLI binary as its own child, hence the tree walk)
            local ppid_map frontier next pid c p depth=0
            ppid_map=$(ps -eo pid=,ppid= 2>/dev/null || true)
            frontier="$$"
            while [[ -n "$frontier" ]] && (( depth < 4 )); do
                next=""
                for pid in $frontier; do
                    while read -r c p; do
                        if [[ "$p" == "$pid" ]]; then next+=" $c"; fi
                    done <<< "$ppid_map"
                done
                [[ -z "$next" ]] && break
                echo "$next"
                frontier=$next
                depth=$((depth + 1))
            done
        }

        _find_log() {   # candidate log whose tail carries this wrapper's CLI pid
            local cands cand pid kids tailbuf
            kids=$(_cli_pids)
            cands=$(_log_candidates)
            while IFS= read -r cand; do
                [[ -z "$cand" ]] && continue
                cand=${cand#* }
                tailbuf=$(tail -c 8192 "$cand" 2>/dev/null || true)
                for pid in $kids; do
                    if grep -q "\"pid\":$pid[,}]" <<< "$tailbuf"; then
                        echo "$cand"
                        return 0
                    fi
                done
            done <<< "$cands"
            return 0
        }

        # ── discover phase ──
        # 30s: the npm launcher does pre-flight work (fingerprint, update
        # check) and can take ~16s before the CLI writes its first log line.
        local logfile="" deadline=$((SECONDS + 30))
        while kill -0 $$ 2>/dev/null && (( SECONDS < deadline )); do
            logfile=$(_find_log)
            [[ -n "$logfile" ]] && break
            sleep 0.25
        done
        if [[ -z "$logfile" ]]; then
            _fire_status "Idle"; rm -f "$state_file"; exit 0
        fi

        # ── watch phase ──
        local offset=0 line activity rediscover=1 timed_out
        offset=$(wc -c < "$logfile" 2>/dev/null || echo 0)
        while kill -0 $$ 2>/dev/null; do
            timeout "$idle_timeout" inotifywait -q -e modify \
                "$logfile" >/dev/null 2>&1 &
            watch_pid=$!
            timed_out=1
            if wait "$watch_pid"; then
                timed_out=0
            elif [[ ! -f "$logfile" ]]; then
                # File vanished (shouldn't happen — pino appends, no
                # rotation): re-discover once, then give up
                if (( rediscover )); then
                    rediscover=0
                    logfile=$(_find_log)
                    [[ -n "$logfile" ]] || { rm -f "$state_file"; exit 0; }
                    offset=$(wc -c < "$logfile" 2>/dev/null || echo 0)
                    continue
                fi
                rm -f "$state_file"; exit 0
            fi
            # Drain bytes appended since the last read on every wake —
            # including idle timeouts — so a marker that raced the watch
            # arm still counts instead of being swallowed by the Idle path
            activity=0
            while IFS= read -r line; do
                case "$line" in
                    *"Start agent "*|*"[message-queue] Processing"*)
                        activity=1 ;;
                    *"[chat-runtime] Freebuff session over"*)
                        activity=0
                        if [[ "$(cat "$state_file")" != "Idle" ]]; then
                            echo "Idle" > "$state_file"; _fire_status "Idle"
                        fi ;;
                esac
            done < <(tail -c +$((offset + 1)) "$logfile" 2>/dev/null)
            offset=$(wc -c < "$logfile" 2>/dev/null || echo "$offset")
            if (( activity )) && [[ "$(cat "$state_file")" != "Running" ]]; then
                echo "Running" > "$state_file"; _fire_status "Running"
            elif (( timed_out )) && [[ "$(cat "$state_file")" == "Running" ]]; then
                # idle timeout with no marker activity
                echo "Idle" > "$state_file"; _fire_status "Idle"
            fi
        done
        rm -f "$state_file"
    ) &
    _STATUS_MONITOR_PID=$!
}
_start_status_monitor

# ── Launch freebuff (no exec — wrapper must survive for cleanup) ───────────

"$REAL_FREEBUFF" "$@"
rc=$?

exit $rc
