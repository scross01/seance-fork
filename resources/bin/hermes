#!/usr/bin/env bash
# seance Hermes Agent wrapper — intercepts `hermes` invocations inside seance
# terminals and exports environment variables for the seance plugin.
set -euo pipefail

# ── Find the real hermes binary, skipping seance wrappers ─────────────────

# A seance wrapper is a 'hermes' binary in the same directory as this script.
# We iterate PATH, skipping the wrapper's own directory, to find the real one.

WRAPPER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REAL_HERMES=""
IFS=: read -ra PATH_DIRS <<< "$PATH"
for dir in "${PATH_DIRS[@]}"; do
    [[ -z "$dir" ]] && continue
    resolved="$(cd "$dir" 2>/dev/null && pwd)" || continue
    [[ "$resolved" == "$WRAPPER_DIR" ]] && continue
    if [[ -x "$dir/hermes" ]]; then
        REAL_HERMES="$dir/hermes"
        break
    fi
done

if [[ -z "$REAL_HERMES" ]]; then
    echo "hermes: command not found" >&2
    exit 127
fi

# Resolve seance to an absolute path to prevent PATH manipulation by the agent
REAL_SEANCE="$(PATH="$PATH" type -P seance 2>/dev/null || true)"
if [[ -z "$REAL_SEANCE" ]]; then
    echo "hermes: seance not found — falling back to pass-through" >&2
    exec "$REAL_HERMES" "$@"
fi

# ── Pass-through conditions ──────────────────────────────────────────────

# Not inside seance
if [[ -z "${SEANCE_SURFACE_ID:-}" ]]; then
    exec "$REAL_HERMES" "$@"
fi

# Hooks explicitly disabled
if [[ "${SEANCE_HERMES_HOOKS_DISABLED:-}" == "1" ]]; then
    exec "$REAL_HERMES" "$@"
fi

# Already inside a wrapped hermes call (recursive invocation from hermes update, etc.)
# Pass through directly to prevent subprocess cascade.
if [[ -n "${SEANCE_HERMES_PID:-}" ]]; then
    exec "$REAL_HERMES" "$@"
fi

# Socket health check (0.75s timeout)
if ! timeout 0.75 "$REAL_SEANCE" ctl --socket "${SEANCE_SOCKET_PATH:-}" ping >/dev/null 2>&1; then
    exec "$REAL_HERMES" "$@"
fi

# ── Export env vars so the seance plugin can reach the sidebar ─────────────

export SEANCE_HERMES_PID=$$

# ── Process-exit cleanup on any exit ──────────────────────────────────────
# Hermes fires on_session_end between turns (mapped to `session-end`), which
# must not clear sidebar status, so that event cannot signal a real process
# exit. This trap fires on EXIT (normal exit + signal exits, covering
# SIGTERM, SIGINT, SIGHUP, etc.) and reports `process-exit`, clearing the
# surface's status entry once no hermes process remains.

_process_exit_cleanup() {
    # Fire-and-forget with a hard timeout to avoid blocking hermes teardown
    timeout 1.0 "$REAL_SEANCE" ctl hermes-hook process-exit >/dev/null 2>&1 &
}
trap _process_exit_cleanup EXIT

# ── Launch hermes (no exec — wrapper must survive for cleanup) ────────────

"$REAL_HERMES" "$@"
rc=$?
exit $rc
