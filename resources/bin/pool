#!/usr/bin/env bash
# seance Poolside wrapper — intercepts `pool` inside seance and fires
# native Pool hooks (configured in ~/.config/poolside/settings.yaml)
# for lifecycle tracking. Session-end cleanup handled via EXIT trap
# since Pool has no SessionEnd hook event.
set -euo pipefail

# ── Find the real pool binary ────────────────────────────────────────────────────────────

WRAPPER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REAL_POOL=""
IFS=: read -ra PATH_DIRS <<< "$PATH"
for dir in "${PATH_DIRS[@]}"; do
    [[ -z "$dir" ]] && continue
    resolved="$(cd "$dir" 2>/dev/null && pwd)" || continue
    [[ "$resolved" == "$WRAPPER_DIR" ]] && continue
    if [[ -x "$dir/pool" ]]; then
        REAL_POOL="$dir/pool"
        break
    fi
done

if [[ -z "$REAL_POOL" ]]; then
    echo "pool: command not found" >&2
    exit 127
fi

# Resolve seance
REAL_SEANCE="$(PATH="$PATH" type -P seance 2>/dev/null || true)"
if [[ -z "$REAL_SEANCE" ]]; then
    exec "$REAL_POOL" "$@"
fi

# ── Pass-through conditions ──────────────────────────────────────────────────────────────

# Not inside seance
if [[ -z "${SEANCE_SURFACE_ID:-}" ]]; then
    exec "$REAL_POOL" "$@"
fi

# Hooks explicitly disabled
if [[ "${SEANCE_POOL_HOOKS_DISABLED:-}" == "1" ]]; then
    exec "$REAL_POOL" "$@"
fi

# Socket health check (0.75s timeout)
if ! timeout 0.75 "$REAL_SEANCE" ctl --socket "${SEANCE_SOCKET_PATH:-}" ping >/dev/null 2>&1; then
    exec "$REAL_POOL" "$@"
fi

# ── Pass-through subcommands ─────────────────────────────────────────────────────────────

case "${1:-}" in
    config|login|logout|update|mcp|secrets|completion|acp)
        exec "$REAL_POOL" "$@"
        ;;
esac

# ── Export PID ───────────────────────────────────────────────────────────────────────────

export SEANCE_POOL_PID=$$

# ── Session-end cleanup trap ─────────────────────────────────────────────────────────────
# Pool has no SessionEnd hook event, so we guarantee cleanup via EXIT.
# This covers normal exit, SIGTERM, SIGINT, SIGHUP, and crashes.
_cleanup() {
    timeout 0.5 "$REAL_SEANCE" ctl pool-hook session-end <<'EOF' >/dev/null 2>&1 &
{}
EOF
}
trap _cleanup EXIT

# ── Launch pool (no exec — wrapper survives for cleanup trap) ────────────────────────────

"$REAL_POOL" "$@"
rc=$?
exit $rc
